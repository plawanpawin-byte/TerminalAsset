      }
    },
    "That file is too large to share (limit %lld MB).": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์นี้ใหญ่เกินกว่าจะแชร์ได้ (จำกัด %lld MB)"
          }
        }
      }
    },
    "You can change where it goes later in the TerminalAsset Inbox.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเปลี่ยนปลายทางได้ภายหลังในกล่องรับเข้าของ TerminalAsset"
          }
        }
      }
