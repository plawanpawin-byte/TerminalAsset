    "TerminalAsset can't add this kind of item yet.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "TerminalAsset ยังเพิ่มรายการประเภทนี้ไม่ได้"
