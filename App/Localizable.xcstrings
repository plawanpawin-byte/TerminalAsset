    },
    "This build can't receive shared items yet. Everything else keeps working.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวอร์ชันนี้ยังรับสิ่งที่แชร์ไม่ได้ ส่วนอื่นทำงานได้ตามปกติ"
          }
