    "TerminalAsset": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "TerminalAsset"
          }
        }
      }
    },
    "TerminalAsset can add events but can't read them, so Today and Search stay empty. Allow full access in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "TerminalAsset เพิ่มกิจกรรมได้แต่อ่านกิจกรรมไม่ได้ หน้าวันนี้และการค้นหาจึงว่างเปล่า อนุญาตการเข้าถึงแบบเต็มในการตั้งค่า"
          }
        }
      }
    },
    "TerminalAsset can show today's forecast for where you are. It uses your approximate location and sends only a rounded coordinate (about 1 km) to the free Open-Meteo weather service. No name, account or calendar data is sent.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "TerminalAsset แสดงพยากรณ์อากาศวันนี้ตามตำแหน่งของคุณได้ โดยใช้ตำแหน่งโดยประมาณและส่งเฉพาะพิกัดที่ปัดเศษแล้ว (ประมาณ 1 กม.) ไปยังบริการสภาพอากาศฟรี Open-Meteo ไม่มีการส่งชื่อ บัญชี หรือข้อมูลปฏิทิน"
          }
        }
      }
    },
    "TerminalAsset can't start": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "TerminalAsset เริ่มทำงานไม่ได้"
          }
        }
      }
    },
    "TerminalAsset reads your calendar on this device to show the context you need, and adds events when you create them. Your calendar is never uploaded.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "TerminalAsset อ่านปฏิทินของคุณบนเครื่องนี้เพื่อแสดงข้อมูลที่คุณต้องใช้ และเพิ่มกิจกรรมเมื่อคุณสร้าง ปฏิทินของคุณจะไม่ถูกอัปโหลด"
          }
        }
      }
    },
    "TerminalAsset shows the notes, links and tasks you need right when each event starts.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "TerminalAsset แสดงโน้ต ลิงก์ และงานที่คุณต้องใช้ในตอนที่แต่ละกิจกรรมเริ่มพอดี"
          }
        }
      }
    },
    "Text": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความ"
          }
        }
      }
    },
    "That calendar is no longer available. Choose another one.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิทินนั้นใช้งานไม่ได้แล้ว กรุณาเลือกปฏิทินอื่น"
          }
        }
      }
    },
    "That event is no longer in your calendar.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กิจกรรมนั้นไม่อยู่ในปฏิทินของคุณแล้ว"
          }
        }
      }
    },
    "That kind of item can't be added here yet.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังเพิ่มรายการประเภทนี้ที่นี่ไม่ได้"
          }
        }
      }
    },
    "That location is too long. Keep it under %lld characters.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถานที่ยาวเกินไป ใช้ไม่เกิน %lld ตัวอักษร"
          }
        }
      }
    },
    "That title is too long. Keep it under %lld characters.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อยาวเกินไป ใช้ไม่เกิน %lld ตัวอักษร"
          }
        }
      }
    },
    "The event has to end after it starts.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กิจกรรมต้องสิ้นสุดหลังเวลาเริ่ม"
          }
        }
      }
    },
    "The file for this item is missing.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบไฟล์ของรายการนี้"
          }
        }
      }
    },
    "The forecast isn't available right now.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ยังไม่มีพยากรณ์อากาศ"
          }
        }
      }
    },
    "The local data store could not be opened on this device.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดที่เก็บข้อมูลบนเครื่องนี้ไม่ได้"
          }
        }
      }
    },
    "The right thing, right on time": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่ใช่ ตรงเวลาพอดี"
          }
        }
      }
    },
    "The same rounded position is sent to Open-Meteo, a free weather service, to get the forecast. It receives no name, account or calendar data.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตำแหน่งที่ปัดเศษเดียวกันจะถูกส่งไปยัง Open-Meteo บริการสภาพอากาศฟรี เพื่อขอพยากรณ์ โดยไม่ได้รับชื่อ บัญชี หรือข้อมูลปฏิทิน"
          }
        }
      }
    },
    "There are no calendar events around the time this was shared.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีกิจกรรมในปฏิทินช่วงเวลาที่แชร์สิ่งนี้"
          }
        }
      }
    },
    "There is nothing to sign up for or sign in to.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องสมัครหรือเข้าสู่ระบบใด ๆ"
          }
        }
      }
    },
    "Things you share from Safari, Photos and Files land here until they're attached to an event.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่คุณแชร์จาก Safari, รูปภาพ และไฟล์จะมาอยู่ที่นี่จนกว่าจะแนบกับกิจกรรม"
