    "Calendar access is off, so TerminalAsset can't show your day. Turn it on in the Settings app.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงปฏิทินปิดอยู่ TerminalAsset จึงแสดงวันของคุณไม่ได้ เปิดได้ในแอปการตั้งค่า"
          }
        }
      }
    },
    "Calendar access is off. Turn it on in Settings to see your day.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงปฏิทินปิดอยู่ เปิดในการตั้งค่าเพื่อดูวันของคุณ"
          }
        }
      }
    },
    "Calendar access is off. Turn on Full Access for TerminalAsset in Settings to see your events.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
