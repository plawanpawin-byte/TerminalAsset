      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนบกับกิจกรรมปัจจุบัน กิจกรรมถัดไป หรือให้ TerminalAsset เลือกให้"
