    },
    "Add events only": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มกิจกรรมได้อย่างเดียว"
          }
        }
      }
    },
    "Add tasks, notes and links to your events, or share things into the Inbox. They'll be searchable here.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มงาน โน้ต และลิงก์ให้กิจกรรมของคุณ หรือแชร์สิ่งต่าง ๆ เข้ากล่องรับเข้า แล้วจะค้นหาได้ที่นี่"
          }
        }
      }
    },
    "Add tasks, notes or links. They'll be shown on Today when this event is close.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มงาน โน้ต หรือลิงก์ แล้วจะแสดงในหน้าวันนี้เมื่อใกล้ถึงกิจกรรมนี้"
          }
        }
      }
    },
